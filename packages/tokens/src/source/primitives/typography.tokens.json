{
  "family": {
    "inter": {
      "$type": "fontFamily",
      "$value": [
        "Inter Variable",
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "strong": {
      "$type": "fontWeight",
      "$value": 600
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1.15
    },
    "snug": {
      "$type": "number",
      "$value": 1.3
    },
    "body": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "tracking": {
    "body": {
      "$type": "dimension",
      "$value": {
        "value": -0.01,
        "unit": "em"
      }
    },
    "heading": {
      "$type": "dimension",
      "$value": {
        "value": -0.03,
        "unit": "em"
      }
    },
    "display": {
      "$type": "dimension",
      "$value": {
        "value": -0.04,
        "unit": "em"
      }
    }
  }
}
