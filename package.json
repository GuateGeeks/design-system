{
  "name": "guategeeks-design-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/themes",
    "packages/theme-runtime",
    "packages/motion",
    "packages/ui",
    "apps/lab"
  ],
  "scripts": {
    "generate": "npm run generate --workspaces --if-present",
    "build": "npm run generate && tsc -b && npm run build --workspaces --if-present",
    "test": "npm run generate && vitest run",
    "typecheck": "tsc -b",
    "e2e": "npm run e2e -w @guategeeks/lab"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
